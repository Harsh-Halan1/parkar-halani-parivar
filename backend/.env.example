# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL)
# Local development:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/parakar_halani_parivar"
# 
# Or with user/password:
# DATABASE_URL="postgresql://username:password@host:port/database_name"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parakar_halani_parivar"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=86400 # 24 hours in seconds
JWT_REFRESH_EXPIRATION=2592000 # 30 days in seconds

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Storage (Supabase - for development)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=parakar-storage

# Google OAuth (Optional, for future SSO)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Dev Mode (for testing without full auth)
DEV_MODE=false
