// This is your Prisma schema file for Parkar Halani Parivar
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  FAMILY_MEMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum RelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  ADOPTIVE_PARENT
  ADOPTIVE_CHILD
}

enum EventType {
  BIRTHDAY
  BIRTH
  DEATH
  ACHIEVEMENT
  GENERAL
}

enum LanguageCode {
  gu // Gujarati
  en // English
  hi // Hindi
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String
  role              Role      @default(FAMILY_MEMBER)
  
  // OAuth
  googleId          String?   @unique
  appleId           String?   @unique
  
  // OTP & Verification
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  otpCode           String?
  otpExpiry         DateTime?
  
  // Security
  refreshToken      String?   @db.Text
  lastLogin         DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  
  // DPDP Compliance
  consentGiven      Boolean   @default(false)
  consentDate       DateTime?
  dataRetentionDays Int       @default(365)
  
  // Profile
  preferredLanguage LanguageCode @default(gu)
  isDarkMode        Boolean      @default(true)
  
  // Relations
  person            Person?
  createdEvents     Event[]
  createdAnnouncements Announcement[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([email])
  @@index([phone])
}

// ============================================
// FAMILY & PERSON
// ============================================

model Family {
  id                String    @id @default(cuid())
  
  // Multilingual name stored as JSONB
  name              Json      // { "gu": "પારકર", "en": "Parkar", "hi": "पारकार" }
  
  // Family head (optional)
  headPersonId      String?   @unique
  headPerson        Person?   @relation("FamilyHead", fields: [headPersonId], references: [id])
  
  // Relations
  members           Person[]  @relation("FamilyMembers")
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([headPersonId])
}

model Person {
  id                String    @id @default(cuid())
  
  // User account link (nullable for non-users)
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  
  // Family link
  familyId          String
  family            Family    @relation("FamilyMembers", fields: [familyId], references: [id])
  headOfFamily      Family?   @relation("FamilyHead")
  
  // Basic Info (Multilingual JSONB)
  firstName         Json      // { "gu": "હર્ષ", "en": "Harsh", "hi": "हर्ष" }
  middleName        Json?
  lastName          Json      // { "gu": "હાલાણી", "en": "Halani", "hi": "हालानी" }
  
  // Personal Details
  gender            Gender
  dateOfBirth       DateTime?
  placeOfBirth      Json?     // { "gu": "ધાનેરા", "en": "Dhanera", "hi": "धानेरा" }
  
  // Contact
  email             String?
  phone             String?
  
  // Address (Multilingual JSONB)
  residentialAddress Json?    // { "gu": "ધાનેરા, ગુજરાત", "en": "Dhanera, Gujarat", "hi": "धानेरा, गुजरात" }
  professionalAddress Json?
  
  // Professional Info
  occupation        Json?     // { "gu": "વિદ્યાર્થી", "en": "Student", "hi": "विद्यार्थी" }
  company           Json?
  
  // Marital Status
  maritalStatus     MaritalStatus @default(SINGLE)
  
  // Death Info
  isDeceased        Boolean   @default(false)
  dateOfDeath       DateTime?
  placeOfDeath      Json?
  causeOfDeath      String?   @db.Text
  
  // Relationships
  relationshipsAsPersonA Relationship[] @relation("PersonA")
  relationshipsAsPersonB Relationship[] @relation("PersonB")
  
  // Events & Announcements
  relatedEvents     Event[]
  relatedAnnouncements Announcement[]
  
  // Profile
  photoUrl          String?
  bio               Json?     // { "gu": "...", "en": "...", "hi": "..." }
  
  // Metadata
  isPrivate         Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([familyId])
  @@index([userId])
  @@index([maritalStatus])
}

// ============================================
// RELATIONSHIPS (Family Tree)
// ============================================

model Relationship {
  id                String    @id @default(cuid())
  
  personAId         String
  personA           Person    @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  
  personBId         String
  personB           Person    @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  
  relationType      RelationType
  
  // Marriage specific
  marriageDate      DateTime?
  divorceDate       DateTime?
  
  // Adoption specific
  adoptionDate      DateTime?
  isAdoptive        Boolean   @default(false)
  
  // Biological parents (for adopted children)
  biologicalParentAId String?
  biologicalParentBId String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([personAId, personBId, relationType])
  @@index([personAId])
  @@index([personBId])
}

// ============================================
// EVENTS
// ============================================

model Event {
  id                String    @id @default(cuid())
  
  // Multilingual content
  title             Json      // { "gu": "...", "en": "...", "hi": "..." }
  description       Json?     // { "gu": "...", "en": "...", "hi": "..." }
  
  type              EventType
  
  // Event details
  eventDate         DateTime
  location          Json?     // { "gu": "...", "en": "...", "hi": "..." }
  
  // Linked person (optional)
  personId          String?
  person            Person?   @relation(fields: [personId], references: [id])
  
  // Creator
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])
  
  // Visibility
  isPublic          Boolean   @default(true)
  
  // Attachments
  imageUrls         String[]  @default([])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([eventDate])
  @@index([type])
  @@index([personId])
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id                String    @id @default(cuid())
  
  // Multilingual content
  title             Json      // { "gu": "...", "en": "...", "hi": "..." }
  content           Json      // { "gu": "...", "en": "...", "hi": "..." }
  
  type              EventType // Reuse EventType enum
  
  // Linked person (optional)
  personId          String?
  person            Person?   @relation(fields: [personId], references: [id])
  
  // Creator
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])
  
  // Visibility
  isPublic          Boolean   @default(true)
  isPinned          Boolean   @default(false)
  
  // Attachments
  imageUrls         String[]  @default([])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([createdAt])
  @@index([type])
  @@index([isPinned])
}

// ============================================
// AUDIT LOG (DPDP Compliance)
// ============================================

model AuditLog {
  id                String    @id @default(cuid())
  
  userId            String?
  action            String    // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity            String    // User, Person, Event, etc.
  entityType        String?   // More specific type information
  entityId          String?
  
  // Request details
  ipAddress         String?
  userAgent         String?   @db.Text
  
  // Changes
  oldData           Json?
  newData           Json?
  
  createdAt         DateTime  @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id                String    @id @default(cuid())
  key               String    @unique
  value             Json
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([key])
}
shadcn/ui